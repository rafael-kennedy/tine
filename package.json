{
  "name": "tine",
  "version": "1.2.0",
  "description": "Tine: a programming language for music. Live-codable, seeded, microtonal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tine": "src/cli/main.ts"
  },
  "scripts": {
    "test": "bun test",
    "build:web": "bun scripts/build-web.ts",
    "build": "bun scripts/build-web.ts && bun scripts/build-bin.ts",
    "build:vscode": "cd editors/vscode && npm run build && npx -y @vscode/vsce@3 package --allow-missing-repository --skip-license -o tine-1.2.0.vsix"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "6"
  }
}
