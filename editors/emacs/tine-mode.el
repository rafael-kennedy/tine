;;; tine-mode.el --- Major mode for Tine, a programming language for music -*- lexical-binding: t; -*-
;; Usage: (load "/path/to/tine-mode.el")  then open a .tine file.
;; With eglot (Emacs 29+), M-x eglot connects to `tine lsp' automatically.

;; BEGIN GENERATED by scripts/sync.ts: do not edit, run `bun run sync`
(defvar tine-font-lock-keywords
  `(("--.*$" . font-lock-comment-face)
    (,(regexp-opt '("let" "voice" "section" "form" "if" "then" "else" "and" "or" "not" "use") 'words) . font-lock-keyword-face)
    (,(regexp-opt '("tempo" "meter" "key" "seed" "tuning") 'words) . font-lock-preprocessor-face)
    (,(regexp-opt '("true" "false" "silence") 'words) . font-lock-constant-face)
    ("\\^\\(#\\|b\\)*-?[0-9]+" . font-lock-constant-face)
    ("\\_<[A-Ga-g]\\(#\\|b\\)*[0-9]?\\_>" . font-lock-constant-face)
    ("@[A-Za-z0-9]+" . font-lock-builtin-face)
    (,(regexp-opt '("kick" "kick2" "rim" "snare" "clap" "snare2" "tom1" "hat" "tom2" "pedal" "tom3" "ohat" "tom4" "tom5" "crash" "tom6" "ride" "china" "ridebell" "tamb" "splash" "cowbell" "crash2" "ride2" "bongo" "bongo2" "conga" "conga2" "shaker" "clave" "block") 'symbols) . font-lock-variable-name-face)
    (,(regexp-opt '("major" "minor" "ionian" "dorian" "phrygian" "lydian" "mixolydian" "aeolian" "locrian" "harmonic_minor" "melodic_minor" "major_pent" "minor_pent" "blues" "whole_tone" "chromatic" "hirajoshi" "double_harmonic" "altered" "lydian_dominant" "lydian_augmented" "mixolydian_b6" "locrian_nat2" "dorian_b2" "phrygian_dominant" "half_whole" "whole_half" "augmented" "major_blues" "bebop_dominant" "bebop_major" "bebop_dorian" "just_major" "slendro" "bohlen_pierce" "keys" "sine" "tri" "saw" "square" "pluck" "bass" "pad" "bell" "organ" "kit" "lead" "upright" "vibes" "synth" "fm" "supersaw" "tb303" "reese" "wobble" "chip" "brass" "strings" "marimba" "noise") 'symbols) . font-lock-type-face)
    ("\\_<\\([a-z_][A-Za-z0-9_]*\\)(" 1 font-lock-function-name-face)
    ("\\.\\([a-z_][A-Za-z0-9_]*\\)" 1 font-lock-function-name-face)))
;; END GENERATED

(defvar tine-mode-syntax-table
  (let ((st (make-syntax-table)))
    (modify-syntax-entry ?_ "w" st)
    (modify-syntax-entry ?# "w" st)
    (modify-syntax-entry ?- ". 12" st)
    (modify-syntax-entry ?\n ">" st)
    (modify-syntax-entry ?< "(>" st)
    (modify-syntax-entry ?> ")<" st)
    st))

;;;###autoload
(define-derived-mode tine-mode prog-mode "Tine"
  "Major mode for editing Tine music programs."
  :syntax-table tine-mode-syntax-table
  (setq-local comment-start "-- ")
  (setq-local comment-end "")
  (setq-local indent-tabs-mode nil)
  (setq-local tab-width 2)
  (setq-local font-lock-defaults '(tine-font-lock-keywords)))

;;;###autoload
(add-to-list 'auto-mode-alist '("\\.tine\\'" . tine-mode))

(with-eval-after-load 'eglot
  (add-to-list 'eglot-server-programs '(tine-mode "tine" "lsp")))

(defun tine-daw ()
  "Open the Tine DAW on the current file."
  (interactive)
  (start-process "tine-daw" "*tine-daw*" "tine" "daw" (buffer-file-name)))

(provide 'tine-mode)
