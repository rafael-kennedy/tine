{
  "New piece": { "prefix": "piece", "body": ["tempo ${1:96}", "key ${2:d} ${3:dorian}", "seed ${4:1}", "", "voice drums = {[kick . snare .] [hat*8]}", "voice bass  = [^1 . ^5 ^4].octave(-2).inst(bass)", "voice keys  = <^1@7 ^4@7>.strum", "$0"] },
  "Voice": { "prefix": "voice", "body": ["voice ${1:name} = [${2:c e g}]$0"] },
  "Section": { "prefix": "section", "body": ["section ${1:verse} ${2:8}", "  voice ${3:name} = [${4:^1 ^3 ^5}]$0"] },
  "Function": { "prefix": "let", "body": ["let ${1:name}(${2:p}) = ${3:p}$0"] },
  "Drum groove": { "prefix": "groove", "body": ["voice ${1:drums} = {[kick . . kick . . snare .] [hat*8].vel([.9 .5])}"] },
  "Every n bars": { "prefix": "every", "body": [".every(${1:4}, ${2:x => x.fast(2)})"] },
  "Per bar": { "prefix": "perbar", "body": ["per_bar(n => ${1:[c e g].transpose(n % 4)})"] }
}
