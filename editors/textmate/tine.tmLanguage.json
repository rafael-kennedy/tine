{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tine",
  "scopeName": "source.tine",
  "fileTypes": [
    "tine"
  ],
  "patterns": [
    {
      "name": "comment.line.double-dash.tine",
      "match": "--.*$"
    },
    {
      "name": "string.quoted.double.tine",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.tine",
          "match": "\\\\."
        }
      ]
    },
    {
      "match": "^\\s*(voice|section)\\s+([A-Za-z_][A-Za-z0-9_#]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.tine"
        },
        "2": {
          "name": "entity.name.section.tine"
        }
      }
    },
    {
      "match": "^\\s*(let)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "captures": {
        "1": {
          "name": "keyword.declaration.tine"
        },
        "2": {
          "name": "entity.name.function.tine"
        }
      }
    },
    {
      "match": "^\\s*(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.tine"
        },
        "2": {
          "name": "variable.other.definition.tine"
        }
      }
    },
    {
      "name": "keyword.control.tine",
      "match": "\\b(if|then|else|and|or|not)\\b"
    },
    {
      "name": "keyword.other.directive.tine",
      "match": "^\\s*(tempo|meter|key|seed|tuning|form|use)\\b"
    },
    {
      "name": "constant.language.boolean.tine",
      "match": "\\b(true|false|silence)\\b"
    },
    {
      "name": "constant.other.degree.tine",
      "match": "\\^(#|b)*-?\\d+"
    },
    {
      "name": "constant.other.note.tine",
      "match": "\\b[A-Ga-g](#|b)*\\d?(?![A-Za-z0-9_#])"
    },
    {
      "name": "constant.numeric.tine",
      "match": "\\b\\d+(\\.\\d+)?(hz|c(?![A-Za-z0-9_])|\\\\\\d+)?"
    },
    {
      "name": "constant.numeric.tine",
      "match": "(?<![A-Za-z0-9_\\)\\]])\\.\\d+"
    },
    {
      "name": "support.constant.drum.tine",
      "match": "\\b(ridebell|cowbell|snare2|splash|crash2|bongo2|conga2|shaker|kick2|snare|pedal|crash|china|ride2|bongo|conga|clave|block|kick|clap|tom1|tom2|tom3|ohat|tom4|tom5|tom6|ride|tamb|rim|hat)\\b"
    },
    {
      "name": "support.type.scale.tine",
      "match": "\\b(double_harmonic|harmonic_minor|melodic_minor|bohlen_pierce|mixolydian|major_pent|minor_pent|whole_tone|just_major|chromatic|hirajoshi|phrygian|aeolian|locrian|slendro|ionian|dorian|lydian|square|major|minor|blues|pluck|organ|keys|sine|bass|bell|lead|tri|saw|pad|kit)\\b"
    },
    {
      "name": "support.function.builtin.tine",
      "match": "\\b(palindrome|sometimes|transpose|humanize|scramble|rand_int|weighted|note_num|arrange|per_bar|degrade|shuffle|degrees|release|sustain|euclid|rarely|chance|octave|invert|legato|cutoff|attack|reverb|sample|square|filter|concat|repeat|rotate|early|every|swing|stack|trunc|often|maybe|chord|strum|pitch|ratio|scale|cents|scala|decay|noise|drift|range|floor|round|clamp|print|fast|slow|late|iter|echo|poly|loop|dice|walk|rand|pick|step|just|mode|gain|inst|midi|held|sine|fold|take|drop|ceil|sqrt|log2|lerp|type|rev|off|ply|cat|seq|key|arp|edo|vel|pan|res|dur|set|mpe|tri|saw|seg|run|len|map|sum|abs|sin|cos|exp|min|max|str|hz|cc|at)\\b(?=\\s*\\(|)"
    },
    {
      "name": "keyword.operator.chord.tine",
      "match": "@[A-Za-z0-9]+"
    },
    {
      "name": "keyword.operator.arrow.tine",
      "match": "=>"
    },
    {
      "name": "keyword.operator.phrase.tine",
      "match": "[|?!_]"
    },
    {
      "name": "keyword.operator.tine",
      "match": "\\*\\*|==|!=|<=|>=|\\.\\.|[-+*/%=]"
    },
    {
      "name": "punctuation.section.phrase.tine",
      "match": "[\\[\\]{}<>]"
    },
    {
      "name": "variable.other.tine",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  ]
}