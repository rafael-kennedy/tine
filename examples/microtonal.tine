-- microtonal.tine: three tuning systems in one piece.
tempo 72
seed 31

section meantone 8
  -- quarter-comma meantone approximated by 31 equal steps per octave
  key c edo(31, [0 5 10 13 18 23 28])
  voice chords = <^1@7 ^4@7 ^5@7 ^1@3>.strum(1/24).inst(organ)
  voice line = [^5 ^4 ^3 _ ^2 ^3 ^5 .].slow(2).inst(pluck)

section harmonic 8
  -- just intonation: pure ratios from the harmonic series
  key d just([1 9/8 5/4 11/8 3/2 13/8 7/4])
  voice drone = {d2 a2}.inst(pad)
  voice partials = map(4..12, k => d2 * k).inst(sine).vel(.4).echo(times: 2, time: 1/12)
  voice line = walk(0..10, 8).degrees.inst(bell).vel(.45)

section pelog 8
  -- a gamelan-like 7-note scale in cents
  key e cents([0 120 270 540 670 785 950])
  voice gongs = [^1 . . . ^5 . ^4 .].octave(-1).inst(bell)
  voice saron = [^1 ^2 ^3 ^5 ^3 ^2 ^1 ^7].scramble.octave(-1).inst(pluck).fast(2)
  voice quarter = [e4 (e4 + 50c) f4 (f4 + 50c)].inst(sine).vel(.3)

form meantone harmonic pelog meantone
