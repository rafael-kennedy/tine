-- groove.tine: a live-coding starting point.
-- Run: tine daw examples/groove.tine
-- Try muting voices, changing ^5 to ^6, or rerolling the seed.
tempo 118
key f# minor

let fill(p) = p.fast(2).vel(.7)

voice kick  = [kick . . . kick . . kick?0.4 . . kick . . . . .]
voice snare = [. . . . snare . . . . . . . snare . . snare?0.3].every(4, fill)
voice hats  = [hat*16].vel([.85 .4 .6 .4]).swing(.25, div: 16).degrade(.1)
voice bass  = [^1 . ^1 . ^b7 . ^1 _ . ^1 ^3 . ^4 . ^5 ^b7]
  .octave(-2)
  .inst(bass)
  .cutoff(sine(8).range(400, 1600))
voice stabs = <^1@7 ^1@7 ^6@7 ^4@9>
  .late(1/8)
  .legato(.3)
  .inst(keys)
  .vel(.6)
voice spark = dice([^5 ^8 ^9 ^10 . . .], 16).inst(bell).vel(.35).pan(drift(.25).range(-.8, .8))
